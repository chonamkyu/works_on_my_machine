# Copy this to .env and fill in.
# .env is gitignored (see .gitignore).

# LLM gateway
PLATFORM_LLMGATE_URL=https://llmgate-api.alpha.doosanrobotics.ai
PLATFORM_LLMGATE_KEY=sk-virt-CHANGE_ME

# Default models (these flow through llmgate → AWS Bedrock)
PLATFORM_MODEL_RUN=anthropic.claude-haiku-4-5
PLATFORM_MODEL_GENERATE=anthropic.claude-opus-4-7
PLATFORM_MODEL_REFLECT=anthropic.claude-haiku-4-5
PLATFORM_MODEL_EVOLVE=anthropic.claude-opus-4-7
PLATFORM_EMBEDDING_MODEL=qwen3-embedding-0.6b

# OAuth (optional — connectors fall back to PAT paste in Settings if absent).
# Register each app at the provider, set callback URL to:
#   http://localhost:8787/oauth/github/callback
#   http://localhost:8787/oauth/slack/callback
PLATFORM_PUBLIC_URL=http://localhost:8787
PLATFORM_GITHUB_CLIENT_ID=
PLATFORM_GITHUB_CLIENT_SECRET=
PLATFORM_SLACK_CLIENT_ID=
PLATFORM_SLACK_CLIENT_SECRET=

# Control plane
PLATFORM_API_ADDR=:8787
PLATFORM_DB_URL=postgres://platform:platform@localhost:5432/platform?sslmode=disable

# Supervisor / sandbox
PLATFORM_SUPERVISOR_HOST=127.0.0.1
PLATFORM_SUPERVISOR_PORT=50051

# Web dev server
PLATFORM_API=http://localhost:8787
