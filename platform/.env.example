# platform/.env.example
# Copy to platform/.env and fill in the placeholders.
# Real secrets must never land in git. .env is .gitignored.

# ─── LLM gateway ────────────────────────────────────────────────────────
# OpenAI-compatible base URL + key. Any OpenAI-compatible gateway works
# (OpenAI, llmgate, Together, Groq, vLLM, …). For Bedrock-backed models
# (anthropic.claude-*) point this at llmgate.
OPENAI_BASE_URL=https://llmgate-api.example.com
OPENAI_API_KEY=sk-virt-REPLACE_ME

# Legacy aliases still honored. Set EITHER the OPENAI_* names above OR
# these — both work, OPENAI_* wins when both are present.
# PLATFORM_LLMGATE_URL=
# PLATFORM_LLMGATE_KEY=

# Model routing per role. The platform reaches the LLM through 4 channels;
# each can pin its own model.
PLATFORM_MODEL_GENERATE=anthropic.claude-opus-4-7
PLATFORM_MODEL_RUN=anthropic.claude-sonnet-4-6
PLATFORM_MODEL_REFLECT=anthropic.claude-haiku-4-5
PLATFORM_MODEL_EVOLVE=anthropic.claude-opus-4-7
PLATFORM_EMBEDDING_MODEL=qwen3-embedding-0.6b

# ─── Database ───────────────────────────────────────────────────────────
# Defaults to postgres://platform:platform@localhost:5432/platform?sslmode=disable
# (matches the bundled compose.yaml). Override for non-local Postgres.
# PLATFORM_DB_URL=postgres://platform:platform@localhost:5432/platform?sslmode=disable

# 32-byte hex used to AES-GCM encrypt rows in the `credentials` table.
# Rotating this invalidates every stored credential. Generate with:
#   openssl rand -hex 32
PLATFORM_ENCRYPTION_KEY=REPLACE_WITH_HEX_32_BYTES

# ─── Service topology ───────────────────────────────────────────────────
# Where each backend service listens. Defaults match the local stack;
# override only when topology changes.
PLATFORM_API_ADDR=:8787
PLATFORM_GENERATOR_URL=http://localhost:8081
PLATFORM_REFLECTION_URL=http://localhost:8082
PLATFORM_VERIFY_URL=http://localhost:8083

# What the browser sees. OAuth callbacks come back here, and absolute URLs
# the agent emits use this prefix. Set to the vite proxy origin in dev.
PLATFORM_PUBLIC_URL=http://localhost:8787

# Where the web dev server forwards /v1, /d, /oauth to. Read by vite.
PLATFORM_API=http://localhost:8787

# Where workflow source trees + per-task node_modules live. Defaults to
# ~/.platform/workflows.
# PLATFORM_WORKFLOW_ROOT=

# Where the @platform/sdk symlink resolves to inside spawned workflows.
# Defaults to ../sdk relative to the api binary's CWD.
# PLATFORM_SDK_PATH=

# Where per-user skill overlays live. Defaults to ../generator/prompts.
# Useful when running the api binary from a non-monorepo location.
# PLATFORM_GENERATOR_PROMPTS_DIR=

# Node binary used to spawn workflows. Defaults to `node` on PATH.
# PLATFORM_NODE=/usr/local/bin/node

# ─── Self-tuning ────────────────────────────────────────────────────────
# How often the SkillEvolver wakes up and asks reflection to propose new
# per-user skills from accumulated memory. Go duration string.
# PLATFORM_SKILL_EVOLVE_TICK=12h

# ─── Connector OAuth (optional) ─────────────────────────────────────────
# Without these, the matching connector falls back to PAT paste in
# Settings → Credentials. Register apps at the provider and set the
# callback URLs to:
#   http://localhost:8787/oauth/github/callback
#   http://localhost:8787/oauth/slack/callback
PLATFORM_GITHUB_CLIENT_ID=
PLATFORM_GITHUB_CLIENT_SECRET=

PLATFORM_SLACK_CLIENT_ID=
PLATFORM_SLACK_CLIENT_SECRET=
PLATFORM_SLACK_APP_ID=

# Jira default base URL when the agent uses jira.* without a per-credential
# override.
# PLATFORM_JIRA_BASE_URL=https://your-org.atlassian.net

# Inbound webhook HMAC secret. Dev-only default is fine for local; rotate
# for any non-local deploy.
# PLATFORM_WEBHOOK_SECRET=dev-secret

# ─── Workflow-side (DO NOT SET HERE) ────────────────────────────────────
# These are injected by the platform at spawn time. Listed for reference:
#   PLATFORM_RUN_ID            current run id (or "dry-run")
#   PLATFORM_TASK_ID           current task id
#   PLATFORM_USER_ID           owning user
#   PLATFORM_PORT              role:"ui" port for service tasks
#   PLATFORM_PORT_<NAME>       one per declared port in workflow.yaml ports[]
#   PLATFORM_TOKEN_<CONN>      one per registered connector credential
#   PLATFORM_DRY_RUN=1         set by the runner during smoke runs
